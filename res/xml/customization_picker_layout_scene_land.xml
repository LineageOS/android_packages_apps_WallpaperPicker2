<!-- Expanded and collapsed states are identical; ids are kept for CustomizationPickerFragment. -->
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Transition
        android:id="@+id/transition_primary"
        app:constraintSetStart="@id/expanded_header_primary"
        app:constraintSetEnd="@id/collapsed_header_primary" />

    <ConstraintSet android:id="@+id/expanded_header_primary">
        <Constraint
            android:id="@+id/preview_header"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/guideline_split" />

        <Constraint
            android:id="@+id/bottom_scroll_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guideline_split"
            app:layout_constraintEnd_toEndOf="parent" />

        <Constraint
            android:id="@+id/customization_option_floating_sheet_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guideline_split"
            app:layout_constraintEnd_toEndOf="parent" />
    </ConstraintSet>

    <ConstraintSet
        android:id="@+id/collapsed_header_primary"
        app:deriveConstraintsFrom="@id/expanded_header_primary" />

    <ConstraintSet android:id="@+id/secondary">
        <Constraint
            android:id="@+id/preview_header"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/guideline_split" />

        <Constraint
            android:id="@+id/bottom_scroll_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0.0"
            android:visibility="invisible"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guideline_split"
            app:layout_constraintEnd_toEndOf="parent" />

        <Constraint
            android:id="@+id/customization_option_floating_sheet_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:alpha="1.0"
            android:translationY="0dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1.0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guideline_split"
            app:layout_constraintEnd_toEndOf="parent" />
    </ConstraintSet>
</MotionScene>
